{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "bun"
    ],
    "lib": [
      "ES2023",
      "DOM"
    ],
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "*.ts",
    "*.tsx"
  ]
}
